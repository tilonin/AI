{
  "name": "aether-world-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "node --import tsx --test src/engine.test.ts src/geopolitics/engine.test.ts src/geopolitics/camera.test.ts src/geopolitics/mapColors.test.ts server/worker.test.ts src/geopolitics/scenarios.test.ts server/worlds.test.ts",
    "server": "node --import tsx server/index.ts",
    "test:e2e": "playwright test",
    "build:hosted": "npm run build && node scripts/build-worker.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/rapier": "^2.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.180.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.8",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "esbuild": "0.28.2",
    "drizzle-kit": "0.31.10"
  }
}
