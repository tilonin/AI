# Local Node.js API; never commit the real .env file.
PORT=3001
BIND_HOST=127.0.0.1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# Required for production; enter the same API_TOKEN in the game settings.
API_TOKEN=
# PostgreSQL is optional for local slots, required for server-side slots.
DATABASE_URL=
# For Docker Compose, set a long unique password; compose constructs DATABASE_URL.
POSTGRES_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
